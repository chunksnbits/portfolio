#!/bin/sh
# Refuses a push whose new commits touch variants/, which belongs to the private repository chunksnbits/portfolio-variants.
# see: DEVELOPMENT.md, "Variants"
#
# Install it once per clone, into the git folder that every worktree shares:
#   cp scripts/pre-push "$(git rev-parse --git-common-dir)/hooks/pre-push"
#
# NOTE: don't point core.hooksPath at scripts/ instead. A branch from before this file has no scripts/pre-push.
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  # A deleted branch pushes no commits.
  [ "$local_sha" = "$zero" ] && continue
  # Every commit the remote doesn't have yet, even on a merged side branch that added variants/ and removed it again.
  # remote_sha stays unused, since this clone may never have fetched that commit.
  if ! commits=$(git rev-list --full-history "$local_sha" --not --remotes="$1" -- variants); then
    echo "pre-push: can't list the commits of $local_ref. Run git fetch, then push again." >&2
    exit 1
  fi
  if [ -n "$commits" ]; then
    echo "pre-push: $local_ref has commits that touch variants/, which this public repository must never hold. Push refused." >&2
    exit 1
  fi
done
